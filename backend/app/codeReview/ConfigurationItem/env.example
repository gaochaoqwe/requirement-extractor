# PostgreSQL数据库配置
# 复制此文件为 .env 并根据实际情况修改

# 数据库主机
POSTGRES_HOST=localhost

# 数据库端口
POSTGRES_PORT=5432

# 数据库名称（统一使用 code_review）
POSTGRES_DB=code_review

# 数据库用户
POSTGRES_USER=code_review

# 数据库密码
POSTGRES_PASSWORD=123456

# ========================================
# 使用说明
# ========================================
#
# 1. 复制此文件为 .env：
#    cp env.example .env
#
# 2. 如果数据库配置不同，请修改 .env 文件中的值
#
# 3. 初始化数据库：
#    cd db
#    python init_postgresql.py
#
# 4. 启动服务：
#    cd ../../../../../../  # 回到项目根目录
#    python backend/run_fastapi.py
#
# ========================================
# 注意事项
# ========================================
#
# - .env 文件会被 .gitignore 忽略，不会提交到Git
# - 生产环境请使用更安全的密码
# - 确保PostgreSQL服务已启动
# - 默认配置适用于本地开发环境
#
